/* =====================================================
   NÚCLEO DE ÁRBITROS DE FUTEBOL MARQUES BOM
   STYLE.CSS - VERSÃO 3.0
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#f5f5f5;
    color:#333;
}

/*==============================*/
/* CONTAINER */
/*==============================*/

.container{
    width:90%;
    max-width:1300px;
    margin:auto;
}

/*==============================*/
/* HEADER */
/*==============================*/

header{

    background:#181818;

    position:sticky;

    top:0;

    z-index:999;

    box-shadow:0 3px 12px rgba(0,0,0,.20);

}

header .container{

    display:flex;

    justify-content:space-between;

    align-items:center;

    min-height:90px;

}

.logo img{

    height:70px;

}

nav ul{

    list-style:none;

    display:flex;

    gap:30px;

}

nav a{

    text-decoration:none;

    color:white;

    font-weight:600;

    transition:.3s;

}

nav a:hover{

    color:#C9A227;

}

/*==============================*/
/* HERO */
/*==============================*/

.hero{

    background:white;

}

.hero-img{

    width:100%;

    display:block;

    border-bottom:6px solid #C9A227;

}

/*==============================*/
/* INTRODUÇÃO */
/*==============================*/

.intro{

    padding:70px 0;

    background:white;

    text-align:center;

}

.intro h1{

    color:#5A2A6A;

    font-size:42px;

    margin-bottom:20px;

}

.intro p{

    max-width:900px;

    margin:auto;

    font-size:20px;

    line-height:34px;

}

/*==============================*/
/* CARTÕES */
/*==============================*/

.servicos{

    padding:70px 0;

}

.servicos .container{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

    gap:30px;

}

.card{

    background:white;

    padding:40px;

    text-decoration:none;

    color:#333;

    border-radius:18px;

    border-top:6px solid #C9A227;

    box-shadow:0 8px 25px rgba(0,0,0,.10);

    transition:.35s;

}

.card:hover{

    transform:translateY(-10px);

    box-shadow:0 20px 40px rgba(0,0,0,.20);

}

.card h2{

    color:#5A2A6A;

    margin-bottom:20px;

    font-size:26px;

}

.card p{

    line-height:30px;

}

/*==============================*/
/* DESTAQUE */
/*==============================*/

.destaque{

    background:#5A2A6A;

    color:white;

    text-align:center;

    padding:80px 20px;

}

.destaque h2{

    font-size:40px;

    margin-bottom:20px;

    color:#C9A227;

}

.destaque p{

    max-width:900px;

    margin:auto;

    font-size:20px;

    line-height:34px;

}

/*==============================*/
/* FOOTER */
/*==============================*/

footer{

    background:#181818;

    color:white;

    padding:50px 0 20px;

}

.footer-grid{

    display:grid;

    grid-template-columns:1fr 1fr 1fr;

    gap:40px;

    align-items:flex-start;

}

.footer-logo{

    height:90px;

}

footer h3{

    margin-bottom:15px;

    color:#C9A227;

}

footer p{

    line-height:28px;

}

footer hr{

    border:none;

    border-top:1px solid rgba(255,255,255,.15);

    margin:35px 0 20px;

}

.copyright{

    text-align:center;

    color:#cccccc;

}

/*==============================*/
/* RESPONSIVO */
/*==============================*/

@media(max-width:900px){

header .container{

    flex-direction:column;

    padding:20px 0;

}

nav ul{

    flex-wrap:wrap;

    justify-content:center;

    gap:18px;

    margin-top:15px;

}

.footer-grid{

    grid-template-columns:1fr;

    text-align:center;

}

.footer-logo{

    margin:auto;

}

}

@media(max-width:700px){

.logo img{

    height:55px;

}

.intro h1{

    font-size:30px;

}

.intro p{

    font-size:18px;

}

.card{

    padding:30px;

}

.destaque h2{

    font-size:30px;

}

.destaque p{

    font-size:18px;

}

}
